{
  "name": "ommis-backend",
  "version": "0.1.0",
  "private": true,
  "description": "OMMIS multi-tenant O&M MIS platform - backend API",
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seeds/run.ts",
    "db:reset": "tsx src/db/reset.ts",
    "create-super-admin": "tsx scripts/create-super-admin.ts",
    "check-rls": "tsx scripts/check-rls.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/lib-storage": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@sentry/node": "^9.47.2",
    "@sparticuz/chromium": "^138.0.2",
    "archiver": "^7.0.1",
    "argon2": "^0.43.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "echarts": "^5.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "file-type": "^16.5.4",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "resend": "^4.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/archiver": "^6.0.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "puppeteer": "^24.43.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
