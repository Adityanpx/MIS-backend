# ---------- runtime ----------
NODE_ENV=development
APP_ENV=local
PORT=4000
LOG_LEVEL=debug
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------- database (ONE Postgres, two login roles) ----------
# Used ONLY by `npm run db:migrate` (owner). Never set this on Render.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ommis_dev
# Used by the running API:
DATABASE_URL=postgresql://app_user:app_user_dev_password@localhost:5432/ommis_dev
ADMIN_DATABASE_URL=postgresql://admin_user:admin_user_dev_password@localhost:5432/ommis_dev
DB_SSL=disable                 # require on Supabase
DB_SSL_CA=                     # optional: PEM text of the Supabase CA (enables certificate verification)
DB_POOL_APP_MAX=8
DB_POOL_ADMIN_MAX=4

# ---------- auth ----------
JWT_CLIENT_SECRET=change-me-client-secret-at-least-32-characters-long-xxxxxxxx
JWT_ADMIN_SECRET=change-me-admin-secret-at-least-32-characters-long-yyyyyyyyy
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TTL_DAYS_CLIENT=7
REFRESH_TTL_HOURS_ADMIN=12
COOKIE_SECURE=false            # true in staging/production (HTTPS)
COOKIE_DOMAIN=                 # e.g. api.example.com in production; empty = host-only
# lax = frontends and API share a parent domain (app.x.com + api.x.com). Use none (+ COOKIE_SECURE=true)
# only while the frontends run on *.vercel.app and the API on *.onrender.com (different sites).
COOKIE_SAMESITE=lax
# 32 random bytes, base64 (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_BASE64=
ADMIN_IP_ALLOWLIST=

# ---------- storage ----------
STORAGE_DRIVER=local           # local | r2
LOCAL_STORAGE_DIR=.storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SIGNED_URL_TTL_SEC=900

# ---------- email ----------
EMAIL_DRIVER=console           # console | resend
RESEND_API_KEY=
EMAIL_FROM="OMMIS <no-reply@example.com>"
EMAIL_REPLY_TO=support@example.com

# ---------- jobs / monitoring ----------
CRON_SECRET=change-me-cron-secret-32-chars-minimum-zzzz
SENTRY_DSN=

# ---------- jobs / pdf (Phase 2) ----------
JOBS_MODE=boss                 # boss | inline | off
PDF_ENABLED=true
CHROME_EXECUTABLE_PATH=        # empty: local uses the puppeteer dev Chrome, production uses @sparticuz/chromium
PDF_MAX_PER_BROWSER=50

# ---------- payments (Phase 3) ----------
RAZORPAY_DRIVER=live           # live | fake (tests) | off (no payment links)
RAZORPAY_API_BASE=https://api.razorpay.com/v1
RAZORPAY_KEY_ID=               # optional fallback; normally entered in Super Admin → Settings → Payment gateway
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
